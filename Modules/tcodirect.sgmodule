#!name=t.co direct
#!desc=t.co 還原回原本的 url, 適用於 Safari(https://beeeeemo.dev/2024/12/利用-loon-移除-twitter/x.com-的超連結追蹤器/)
#!category=Tweaks

[Script]
t.co Direct = type=http-response,pattern=^https:\/\/x\.com\/i\/api\/graphql\/[A-Za-z0-9_-]+\/[^?]*(Tweet|Timeline|Media|Search|Bookmark|Likes),requires-body=true,max-size=0,timeout=10,debug=false,script-path=https://raw.githubusercontent.com/jkgtw/Surge/refs/heads/master/JS/tco_direct.js

[MITM]
hostname = %APPEND% x.com
